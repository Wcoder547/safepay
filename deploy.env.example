# Copy to .env.production / Render / Vercel — never commit real secrets.

# --- Backend (Render / Railway) ---
NODE_ENV=production
PORT=8000
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
ACCESS_TOKEN_SECRET=generate-a-long-random-string
REFRESH_TOKEN_SECRET=generate-another-long-random-string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
CORS_ORIGIN=https://YOUR-FRONTEND.vercel.app
ML_API_URL=https://safepay-ml.onrender.com
ML_MODEL_VERSION=v1.0.0
# Free-tier demo (ML cold starts):
DEMO_ALLOW_ML_FALLBACK=true
ALLOW_MOCK_TOPUP=true
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Frontend (Vercel) ---
# VITE_API_URL=https://safepay-backend.onrender.com/api/v1
